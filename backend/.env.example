# Magento CMS Sync backend configuration.
# Every variable below is read by backend/config.py (pydantic-settings, case-insensitive).
# Values shown are the defaults; copy this file to .env and change what you need.

# SQLite database for instances, snapshots metadata and sync history (async driver required).
DATABASE_URL=sqlite+aiosqlite:///./cmssync.db

# Where the cached CMS snapshots (one blocks.json / pages.json per instance) are written.
DATA_DIR=data
INSTANCES_DATA_DIR=data/instances

# Browser origins allowed to call the API (comma-separated or a JSON list).
# Only needed when the UI is served from a different origin than the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Magento REST client: per-request timeout (seconds), retries on 5xx/network errors,
# and the base delay between retries (seconds, multiplied by the attempt number).
MAGENTO_TIMEOUT=30
MAGENTO_RETRY_ATTEMPTS=3
MAGENTO_RETRY_DELAY=1

# Formatting of the snapshot JSON files.
JSON_INDENT=2
JSON_ENSURE_ASCII=false
