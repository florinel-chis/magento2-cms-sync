# Magento CMS Sync frontend configuration (Create React App; values are baked in at build time).

# Base URL of the backend API, INCLUDING the /api prefix.
# Leave it unset in development: the dev server proxies /api to http://localhost:8000
# (see "proxy" in package.json). The Docker image also leaves it unset and lets nginx
# proxy /api to the backend container.
# REACT_APP_API_URL=https://cms-sync.example.com/api

# Dev server port (3000 by default; 3001 is also allowed by the backend's default CORS list).
PORT=3001
