# API Configuration
# Base URL of the backend API, INCLUDING the /api prefix. Leave it unset in development:
# the dev server proxies /api to http://localhost:8000 (see "proxy" in package.json).
REACT_APP_API_URL=http://localhost:8000/api

# Application Port (optional)
PORT=3000

# Environment
NODE_ENV=development

# Features (optional)
REACT_APP_ENABLE_DEBUG=false
REACT_APP_ENABLE_ANALYTICS=false

# Timeouts (in milliseconds)
REACT_APP_API_TIMEOUT=30000
REACT_APP_SYNC_POLL_INTERVAL=5000

# UI Configuration
REACT_APP_DEFAULT_PAGE_SIZE=25
REACT_APP_MAX_PAGE_SIZE=100