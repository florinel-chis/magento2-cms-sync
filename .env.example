# Magento CMS Sync - Environment Configuration
# Copy this file to .env and update with your actual values

# ============================================================================
# SECURITY - API TOKEN ENCRYPTION (REQUIRED)
# ============================================================================
# Generate a new key with:
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
#
# ⚠️  CRITICAL: Keep this key secure and backed up!
# If lost, you cannot decrypt existing API tokens.
ENCRYPTION_KEY=your-generated-fernet-key-here-must-be-44-chars

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DATABASE_URL=sqlite+aiosqlite:///./cmssync.db

# For PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/cmssync

# For MySQL:
# DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/cmssync

# ============================================================================
# API CONFIGURATION
# ============================================================================
API_PREFIX=/api

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# For production, add your actual domains:
# CORS_ORIGINS=https://cms-sync.yourcompany.com,https://app.yourcompany.com

# ============================================================================
# MAGENTO API SETTINGS
# ============================================================================
MAGENTO_TIMEOUT=30
MAGENTO_RETRY_ATTEMPTS=3
MAGENTO_RETRY_DELAY=1

# ============================================================================
# DATA STORAGE
# ============================================================================
DATA_DIR=data
INSTANCES_DATA_DIR=data/instances

# ============================================================================
# JSON STORAGE SETTINGS
# ============================================================================
JSON_INDENT=2
JSON_ENSURE_ASCII=false
